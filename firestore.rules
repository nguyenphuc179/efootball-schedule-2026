rules_version = '2';

// ============================================================================
// Football Tournament Management Platform — Firestore Security Rules
//
// Roles are stored on the user's own document: users/{uid}.role ∈ {admin, viewer}
// Guests (unauthenticated) get read-only access to public tournament data.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers — must live inside this match block so $(database) resolves
    // and get()/exists() are in the service's defining scope.
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(currentUid()));
    }

    // An admin can flip `users/{uid}.disabled` to lock someone out app-wide (there is no
    // client-side way to disable a Firebase Auth account). Every privileged check below
    // fails for a disabled user, and the app also signs them out on sight.
    function isDisabled() {
      return exists(/databases/$(database)/documents/users/$(currentUid())) &&
        userDoc().data.get('disabled', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && !isDisabled() &&
        exists(/databases/$(database)/documents/users/$(currentUid())) &&
        userDoc().data.role == 'admin';
    }

    function isOwnUser(uid) {
      return isSignedIn() && currentUid() == uid;
    }

    // A team manager may manage only their own team's roster (players).
    function isTeamManager(teamId) {
      return isSignedIn() && !isDisabled() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.managerUid == currentUid();
    }

    // The one non-admin manager (if any) an admin designated on `tournaments/{tournamentId}` to
    // click the fixture/bracket "Generate" buttons themselves (transparency for the draw) — only
    // ever ADDS permission alongside isAdmin(), never replaces the admin-only default elsewhere.
    function isFixtureGenerator(tournamentId) {
      return isSignedIn() && !isDisabled() &&
        exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
        get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.get('fixtureGeneratorUid', null) == currentUid();
    }

    // The signed-in manager a `lineups/{parentId}` doc belongs to — parentId is
    // `{tournamentId}__{email}` (see LineupService.parentId), so ownership is proven by matching
    // the caller's own verified email (from their Google-signed ID token, not client-supplied data)
    // against that suffix. Lets a manager manage only their own slots, never another manager's.
    function isLineupOwner(parentId) {
      return isSignedIn() && !isDisabled() &&
        request.auth.token.email != null &&
        parentId.split('__')[1] == request.auth.token.email.lower();
    }

    function validTournamentType(t) {
      return t in ['round_robin', 'knockout', 'group_knockout'];
    }

    // -------------------------------------------------------------------
    // users/{uid} — profile + role. Self-readable/writable (limited fields);
    // role changes require admin (enforced via Cloud Function in production;
    // client-side we forbid users from elevating their own role here).
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn();            // any signed-in user can resolve a profile
      allow list: if isAdmin();              // only admins may enumerate all members
      allow create: if isOwnUser(uid) &&
                      request.resource.data.role == 'viewer'; // new signups start as viewer
      // Self-edits: profile fields only — never your own role or disabled flag.
      allow update: if isOwnUser(uid) &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.get('disabled', false) == resource.data.get('disabled', false);
      // Admins manage OTHER members' role / disabled flag (not their own).
      allow update: if isAdmin() && uid != currentUid();
      allow delete: if false; // members are locked out via `disabled`, not deleted
    }

    // -------------------------------------------------------------------
    // tournaments/{tournamentId} — public read (guests included),
    // admin-only write.
    // -------------------------------------------------------------------
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin() && validTournamentType(request.resource.data.type);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // teams/{teamId} — public read, admin write. Team manager may update
    // limited fields (e.g. logo) on their own team.
    // -------------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isTeamManager(teamId);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // matches/{matchId} — public read, admin write (fixtures). Results are
    // the one exception: a team manager may also update a match they're
    // playing in (home or away), but ONLY the result fields — the diff
    // check below rejects a manager touching anything else (schedule,
    // teams, round, tournamentId, ...), which stays admin-only.
    // -------------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAdmin() || isFixtureGenerator(request.resource.data.tournamentId);
      allow update: if isAdmin() ||
        (isSignedIn() && !isDisabled() &&
          (isTeamManager(resource.data.homeTeamId) || isTeamManager(resource.data.awayTeamId)) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['homeScore', 'awayScore', 'penaltyHome', 'penaltyAway', 'status']));
      allow delete: if isAdmin() || isFixtureGenerator(resource.data.tournamentId);
    }

    // -------------------------------------------------------------------
    // standings/{tournamentId} — derived/denormalized data, public read.
    // `StandingsService.recalculate()` re-derives and batch-writes EVERY
    // team's row in the tournament as one atomic commit whenever any match
    // in it changes — Firestore batches are all-or-nothing, so once a team
    // manager can update their own match's result (see `matches` above),
    // write access here can't stay scoped to just their own row (that
    // would make the batch's OTHER rows fail and roll back the whole
    // thing). Opened to any signed-in, non-disabled member instead — an
    // acceptable tradeoff since this collection is a fully recomputable
    // cache of `matches` (the real source of truth), never source data
    // itself, so worst case a bad write here is undone by the next
    // legitimate recalculate.
    // -------------------------------------------------------------------
    match /standings/{tournamentId} {
      allow read: if true;
      allow write: if isSignedIn() && !isDisabled();

      match /rows/{teamId} {
        allow read: if true;
        allow write: if isSignedIn() && !isDisabled();
      }
    }

    // -------------------------------------------------------------------
    // activityLogs/{logId} — audit trail of every notable mutation in the app
    // (who did what, when). Any signed-in, non-disabled user may create an
    // entry, but ONLY stamped with their OWN uid as actorUid (no spoofing
    // another actor). Admins may read every entry ("/history"); a non-admin
    // may only read entries where they're the actor OR the `subjectUid` (see
    // below) — their own personal feed on that same page. Entries are never
    // editable. Admins MAY delete entries (bulk "clear history" / "clear
    // filtered results" on the "/history" page — an explicit product
    // decision to allow pruning, even though it weakens the log as a tamper-
    // proof trail; ActivityLogService logs the purge itself as a new entry
    // afterwards so at least the fact that a purge happened isn't erasable).
    //
    // A second, narrower `create` branch below lets the external lineup
    // capture tool (see `lineups/{parentId}` below and
    // LINEUP_TOOL_INTEGRATION.md) log its own uploads even though it has no
    // Firebase Auth session — same "public write, locked-down schema"
    // tradeoff already made for `lineups`. It's pinned to a fixed sentinel
    // `actorUid` (never a real uid, so it never matches the "/history" actor
    // filter, which only lists real managers), a single `action`, and a
    // `sourcePath`/`menuKey` that must point at the tournament the image
    // belongs to — it cannot be used to write an arbitrary log entry.
    //
    // `subjectUid` names the user the action is ABOUT when that's someone
    // other than the actor (e.g. the manager whose lineup slot an admin or
    // the capture tool touched) — optional and unvalidated beyond type/size
    // (it's only ever used to grant read access to that one user, never to
    // change what the write itself is allowed to do).
    // -------------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow read: if isSignedIn() && !isDisabled() &&
        (resource.data.actorUid == currentUid() || resource.data.get('subjectUid', null) == currentUid());
      allow create: if isSignedIn() && !isDisabled() &&
        request.resource.data.actorUid == currentUid() &&
        request.resource.data.keys().hasOnly(
          ['actorUid', 'actorEmail', 'actorName', 'action', 'description', 'tournamentId', 'subjectUid', 'sourcePath', 'menuKey', 'createdDate']
        ) &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() > 0 && request.resource.data.actorName.size() < 200 &&
        (request.resource.data.actorEmail == null ||
          (request.resource.data.actorEmail is string && request.resource.data.actorEmail.size() < 320)) &&
        request.resource.data.action is string && request.resource.data.action.size() < 100 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 && request.resource.data.description.size() < 2000 &&
        (request.resource.data.tournamentId == null ||
          (request.resource.data.tournamentId is string && request.resource.data.tournamentId.size() < 200)) &&
        (request.resource.data.get('subjectUid', null) == null ||
          (request.resource.data.subjectUid is string && request.resource.data.subjectUid.size() < 200)) &&
        request.resource.data.sourcePath is string && request.resource.data.sourcePath.size() < 500 &&
        request.resource.data.menuKey is string && request.resource.data.menuKey.size() < 100 &&
        request.resource.data.createdDate is number;
      allow create: if request.resource.data.actorUid == 'capture-tool' &&
        request.resource.data.action == 'lineup_upload' &&
        request.resource.data.keys().hasOnly(
          ['actorUid', 'actorEmail', 'actorName', 'action', 'description', 'tournamentId', 'subjectUid', 'sourcePath', 'menuKey', 'createdDate']
        ) &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() > 0 && request.resource.data.actorName.size() < 200 &&
        request.resource.data.actorEmail is string &&
        request.resource.data.actorEmail.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.actorEmail.size() < 320 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 && request.resource.data.description.size() < 2000 &&
        request.resource.data.tournamentId is string &&
        exists(/databases/$(database)/documents/tournaments/$(request.resource.data.tournamentId)) &&
        (request.resource.data.get('subjectUid', null) == null ||
          (request.resource.data.subjectUid is string && request.resource.data.subjectUid.size() < 200)) &&
        request.resource.data.sourcePath == '/tournaments/' + request.resource.data.tournamentId &&
        request.resource.data.menuKey == 'tournaments' &&
        request.resource.data.createdDate is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // activityLogSeen/{uid} — one user's own "last seen" cursor for their view
    // of the activityLogs feed (doc id = uid) — the full "/history" for an
    // admin, or just their own actor/subject entries for anyone else (see
    // `activityLogs` above) — plus a sub-collection of individually
    // marked-seen entries newer than that cursor ("mark this one as seen").
    // Private: only that user may read or write their own cursor/items; being
    // signed in and not disabled is enough, no admin check (everyone gets
    // their own bell badge now, not just admins). `activityLogs` entries
    // themselves are never touched by any of this.
    // -------------------------------------------------------------------
    match /activityLogSeen/{uid} {
      allow read: if isOwnUser(uid) && !isDisabled();
      allow write: if isOwnUser(uid) && !isDisabled() &&
        request.resource.data.keys().hasOnly(['lastSeenAt']) &&
        request.resource.data.lastSeenAt is number;

      match /items/{logId} {
        allow read: if isOwnUser(uid) && !isDisabled();
        allow create: if isOwnUser(uid) && !isDisabled() &&
          request.resource.data.keys().hasOnly(['seenAt']) &&
          request.resource.data.seenAt is number;
        allow update: if false;
        allow delete: if isOwnUser(uid) && !isDisabled();
      }
    }

    // -------------------------------------------------------------------
    // champions/{championId} — public Hall of Fame; admin-only write.
    // managerImages/{slug} — admin-supplied portraits for the Ranking page.
    // -------------------------------------------------------------------
    match /champions/{championId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /managerImages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // polls/{pollId} — quick group polls. Any signed-in member may read and
    // vote; only an admin may create or delete a poll. Immutable once
    // created (no edit).
    // votes/{uid} — one vote per account: doc id is the voter's own uid, and
    // it can never be updated/deleted, so a member can't change their vote.
    // -------------------------------------------------------------------
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();

      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwnUser(uid);
        allow update: if false;
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // lineups/{tournamentId}__{email}/images/{slot} — squad lineup screenshots,
    // identified only by the manager's Gmail address, no Firebase Auth involved.
    // Normally pushed in by an external capture tool; an admin (or the manager
    // themselves, signed in) can also write here manually from this app's own UI (the
    // "Đội hình thi đấu" tab) for managers who can't run that tool (e.g. console/PS5
    // players) — same path, same shape. Public, unauthenticated write on purpose
    // (explicit product decision): the mitigations below block junk collections,
    // oversized payloads and non-image data even without requiring sign-in.
    // Delete: an admin any time, or the owning manager for their own not-yet-approved
    // slot — once admin has approved it, only admin can remove it.
    // -------------------------------------------------------------------
    match /lineups/{parentId} {
      match /images/{slot} {
        allow read: if true;
        allow create, update: if slot in ['1', '2', '3', '4']
          && exists(/databases/$(database)/documents/tournaments/$(parentId.split('__')[0]))
          && request.resource.data.keys().hasOnly(['image'])
          && request.resource.data.image is string
          && request.resource.data.image.matches('^data:image/.*')
          && request.resource.data.image.size() < 900000;
        allow delete: if isAdmin() ||
          (isLineupOwner(parentId) &&
            (!exists(/databases/$(database)/documents/lineups/$(parentId)/approvals/$(slot)) ||
              get(/databases/$(database)/documents/lineups/$(parentId)/approvals/$(slot)).data.approved != true));
      }

      // approvals/{slot} — "reviewed this screenshot" flag, kept in its own subcollection (not a
      // field on images/{slot}) so it never has to satisfy that doc's public, locked-down
      // `hasOnly(['image'])` write contract above. Only an admin sets/clears the flag itself, but
      // the owning manager may also delete it — needed so LineupService.upload's "drop any stale
      // approval" step succeeds when that manager replaces their own screenshot.
      match /approvals/{slot} {
        allow read: if true;
        allow create, update: if isAdmin() && slot in ['1', '2', '3', '4']
          && request.resource.data.keys().hasOnly(['approved'])
          && request.resource.data.approved is bool;
        allow delete: if isAdmin() || isLineupOwner(parentId);
      }
    }

    // Fallback: deny everything else by default.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
