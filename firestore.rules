rules_version = '2';

// ============================================================================
// Football Tournament Management Platform — Firestore Security Rules
//
// Roles are stored on the user's own document: users/{uid}.role ∈ {admin, viewer}
// Guests (unauthenticated) get read-only access to public tournament data.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helpers — must live inside this match block so $(database) resolves
    // and get()/exists() are in the service's defining scope.
    // -------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(currentUid()));
    }

    // An admin can flip `users/{uid}.disabled` to lock someone out app-wide (there is no
    // client-side way to disable a Firebase Auth account). Every privileged check below
    // fails for a disabled user, and the app also signs them out on sight.
    function isDisabled() {
      return exists(/databases/$(database)/documents/users/$(currentUid())) &&
        userDoc().data.get('disabled', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && !isDisabled() &&
        exists(/databases/$(database)/documents/users/$(currentUid())) &&
        userDoc().data.role == 'admin';
    }

    function isOwnUser(uid) {
      return isSignedIn() && currentUid() == uid;
    }

    // A team manager may manage only their own team's roster (players).
    function isTeamManager(teamId) {
      return isSignedIn() && !isDisabled() &&
        exists(/databases/$(database)/documents/teams/$(teamId)) &&
        get(/databases/$(database)/documents/teams/$(teamId)).data.managerUid == currentUid();
    }

    function validTournamentType(t) {
      return t in ['round_robin', 'knockout', 'group_knockout'];
    }

    // -------------------------------------------------------------------
    // users/{uid} — profile + role. Self-readable/writable (limited fields);
    // role changes require admin (enforced via Cloud Function in production;
    // client-side we forbid users from elevating their own role here).
    // -------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn();            // any signed-in user can resolve a profile
      allow list: if isAdmin();              // only admins may enumerate all members
      allow create: if isOwnUser(uid) &&
                      request.resource.data.role == 'viewer'; // new signups start as viewer
      // Self-edits: profile fields only — never your own role or disabled flag.
      allow update: if isOwnUser(uid) &&
                      request.resource.data.role == resource.data.role &&
                      request.resource.data.get('disabled', false) == resource.data.get('disabled', false);
      // Admins manage OTHER members' role / disabled flag (not their own).
      allow update: if isAdmin() && uid != currentUid();
      allow delete: if false; // members are locked out via `disabled`, not deleted
    }

    // -------------------------------------------------------------------
    // tournaments/{tournamentId} — public read (guests included),
    // admin-only write.
    // -------------------------------------------------------------------
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isAdmin() && validTournamentType(request.resource.data.type);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // teams/{teamId} — public read, admin write. Team manager may update
    // limited fields (e.g. players roster / logo) on their own team.
    // -------------------------------------------------------------------
    match /teams/{teamId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || isTeamManager(teamId);
      allow delete: if isAdmin();

      match /players/{playerId} {
        allow read: if true;
        allow write: if isAdmin() || isTeamManager(teamId);
      }
    }

    // -------------------------------------------------------------------
    // matches/{matchId} — public read, admin write (fixtures + results).
    // -------------------------------------------------------------------
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // standings/{tournamentId} — derived/denormalized data, public read,
    // written only by admin actions (result entry recalculates standings).
    // -------------------------------------------------------------------
    match /standings/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();

      match /rows/{teamId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // -------------------------------------------------------------------
    // activityLogs/{logId} — admin-only audit trail of every notable mutation
    // in the app (who did what, when). Any signed-in, non-disabled user may
    // create an entry, but ONLY stamped with their OWN uid as actorUid (no
    // spoofing another actor). Only admins may ever read the log; entries are
    // never editable. Admins MAY delete entries (bulk "clear history" /
    // "clear filtered results" on the "/history" page — an explicit product
    // decision to allow pruning, even though it weakens the log as a tamper-
    // proof trail; ActivityLogService logs the purge itself as a new entry
    // afterwards so at least the fact that a purge happened isn't erasable).
    // -------------------------------------------------------------------
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && !isDisabled() &&
        request.resource.data.actorUid == currentUid() &&
        request.resource.data.keys().hasOnly(
          ['actorUid', 'actorEmail', 'actorName', 'action', 'description', 'tournamentId', 'sourcePath', 'menuKey', 'createdDate']
        ) &&
        request.resource.data.actorName is string &&
        request.resource.data.actorName.size() > 0 && request.resource.data.actorName.size() < 200 &&
        (request.resource.data.actorEmail == null ||
          (request.resource.data.actorEmail is string && request.resource.data.actorEmail.size() < 320)) &&
        request.resource.data.action is string && request.resource.data.action.size() < 100 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 && request.resource.data.description.size() < 2000 &&
        (request.resource.data.tournamentId == null ||
          (request.resource.data.tournamentId is string && request.resource.data.tournamentId.size() < 200)) &&
        request.resource.data.sourcePath is string && request.resource.data.sourcePath.size() < 500 &&
        request.resource.data.menuKey is string && request.resource.data.menuKey.size() < 100 &&
        request.resource.data.createdDate is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // activityLogSeen/{uid} — one admin's own "last seen" cursor for the
    // activityLogs feed (doc id = uid), plus a sub-collection of individually
    // marked-seen entries newer than that cursor ("mark this one as seen").
    // Private: only that admin may read or write their own cursor/items.
    // `activityLogs` entries themselves are never touched by any of this.
    // -------------------------------------------------------------------
    match /activityLogSeen/{uid} {
      allow read: if isOwnUser(uid) && isAdmin();
      allow write: if isOwnUser(uid) && isAdmin() &&
        request.resource.data.keys().hasOnly(['lastSeenAt']) &&
        request.resource.data.lastSeenAt is number;

      match /items/{logId} {
        allow read: if isOwnUser(uid) && isAdmin();
        allow create: if isOwnUser(uid) && isAdmin() &&
          request.resource.data.keys().hasOnly(['seenAt']) &&
          request.resource.data.seenAt is number;
        allow update: if false;
        allow delete: if isOwnUser(uid) && isAdmin();
      }
    }

    // -------------------------------------------------------------------
    // champions/{championId} — public Hall of Fame; admin-only write.
    // managerImages/{slug} — admin-supplied portraits for the Ranking page.
    // -------------------------------------------------------------------
    match /champions/{championId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /managerImages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // polls/{pollId} — quick group polls. Any signed-in member may read and
    // vote; only an admin may create or delete a poll. Immutable once
    // created (no edit).
    // votes/{uid} — one vote per account: doc id is the voter's own uid, and
    // it can never be updated/deleted, so a member can't change their vote.
    // -------------------------------------------------------------------
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();

      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwnUser(uid);
        allow update: if false;
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------
    // lineups/{tournamentId}__{email}/images/{slot} — squad lineup screenshots,
    // identified only by the manager's Gmail address, no Firebase Auth involved.
    // Normally pushed in by an external capture tool; an admin can also write
    // here manually from this app's own UI (the "Đội hình thi đấu" tab) for
    // managers who can't run that tool (e.g. console/PS5 players) — same path,
    // same shape. Public, unauthenticated write on purpose (explicit product
    // decision): the mitigations below block junk collections, oversized
    // payloads and non-image data even without requiring sign-in.
    // Only an admin can delete a bad/stale image from the app itself.
    // -------------------------------------------------------------------
    match /lineups/{parentId} {
      match /images/{slot} {
        allow read: if true;
        allow create, update: if slot in ['1', '2', '3', '4']
          && exists(/databases/$(database)/documents/tournaments/$(parentId.split('__')[0]))
          && request.resource.data.keys().hasOnly(['image'])
          && request.resource.data.image is string
          && request.resource.data.image.matches('^data:image/.*')
          && request.resource.data.image.size() < 900000;
        allow delete: if isAdmin();
      }
    }

    // Fallback: deny everything else by default.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
