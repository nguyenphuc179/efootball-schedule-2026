rules_version = '2';

// ============================================================================
// Firebase Storage rules
// Layout:
//   /tournaments/{tournamentId}/banner.jpg
//   /teams/{teamId}/logo.jpg
//   /users/{uid}/avatar.jpg
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /tournaments/{tournamentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /teams/{teamId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
